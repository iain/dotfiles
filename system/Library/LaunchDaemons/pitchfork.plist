<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rendered by `mise bootstrap` from mise.toml into /Library/LaunchDaemons.
  Runs the pitchfork supervisor as root at boot (the proxy binds port 443);
  settings.supervisor.user in /etc/pitchfork/config.toml runs daemons as the user.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pitchfork</string>
  <!-- mise's `latest` link, so upgrading pitchfork never leaves a dangling path. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{ vars.mise_data_dir }}/installs/pitchfork/latest/pitchfork</string>
    <string>supervisor</string>
    <string>run</string>
    <string>--boot</string>
  </array>
  <!--
    launchd gives system daemons no HOME and a bare PATH. Daemons run under
    `mise x`, which needs both to find mise and its global [env].
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ vars.home }}</string>
    <key>PATH</key>
    <string>{{ vars.home }}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/opt/homebrew/opt/postgresql@18/bin:/opt/homebrew/opt/libpq/bin:/opt/podman/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash, but let `pitchfork supervisor stop` stay stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>SessionCreate</key>
  <true/>
</dict>
</plist>
