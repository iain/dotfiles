<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Loads the pitchfork port forward (/etc/pf.anchors/dotfiles-pitchfork) at boot
  and enables pf. Only root-owned system binaries and files are involved.
  The anchor must live under com.apple/: /etc/pf.conf only evaluates com.apple/*.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.pitchfork-pf</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/sbin/pfctl -a com.apple/250.dotfiles-pitchfork -f /etc/pf.anchors/dotfiles-pitchfork &amp;&amp; /sbin/pfctl -E</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
