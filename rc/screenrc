# GNU screen — requires screen 5.x (`brew install screen`).
# macOS ships 4.00.03 from 2006, which predates 24-bit colour entirely and
# mangles truecolor SGR sequences into missing backgrounds and wrong hues.

# --- Colour ---------------------------------------------------------------

# screen's built-in default is TERM=screen, which advertises 8 colours and
# quantises everything else down to them.
term screen-256color

# 24-bit passthrough. screen(1): "Currently autodetection of truecolor support
# cannot be done reliably, as such it's left to user to enable. Default is off."
truecolor on

# COLORTERM doesn't survive ssh (sshd only accepts LANG/LC_*), and plenty of
# tools sniff it rather than terminfo. Re-assert it for every forked shell.
setenv COLORTERM truecolor

# Background colour erase. Off by default; without it applications can't paint
# a background out to the end of the line.
defbce on

# --- Session behaviour ----------------------------------------------------

startup_message off
defutf8 on

# Restore the shell view after a full-screen program (vim, less) exits,
# instead of leaving its contents pasted into the scrollback.
altscreen on

defscrollback 20000

# Matters over flaky SSH: if the connection dies without a hangup, don't let
# the dead display block every window. screen(1) calls out exactly this case.
nonblock on

vbell off

# --- Status line ----------------------------------------------------------
# Styled to match spectral (~/Code/spectral). Colours are fg;bg -- screen 5
# deprecated the old k/r/g/y/b/m/c/w letters in favour of 0-7 ANSI, 0-255
# indexed, or #rrggbb truecolor, and `truecolor on` above makes the hex real:
# #F9AD26 goes out as ESC[48;2;249;173;38m, not a 256-colour approximation.
#
# The structure mirrors the theme's own lightline palette, so the bar reads as
# the same design language as the editor:
#
#   raised segment  fg_light  on bg_alt2   -- session name, hostname
#   base bar        fg_darker on bg_alt    -- window list, clock
#   current window  bg        on amber     -- the one accent
#
# Amber appears exactly once. It marks the window you are in and nothing else;
# spreading it further is what makes an amber theme read as a novelty.

hardstatus alwayslastline '%{= #F4E6CA;#403D36} %S %{= #7B7463;#282622} %-Lw%{= #1A1815;#F9AD26} %n %t %{= #7B7463;#282622}%+Lw%=%{= #F4E6CA;#403D36} %H %{= #7B7463;#282622} %c '

# Spectral Light -- swap for the line above. screen has no notion of &background,
# so this is a manual switch rather than something it can track.
