#!/bin/sh
# Runs the pitchfork supervisor for the dev.mise.pitchfork LaunchAgent declared in
# mise.toml. It runs as the user; a root-owned pf rule forwards loopback 443 to
# its proxy, so nothing user-writable runs as root.
#
# launchd gives agents a bare PATH, but daemons run under `mise x`, which needs
# mise (and Homebrew tools) on it. `mise x` also picks the newest installed
# pitchfork and applies the global [env] with the XDG locations.
set -eu

PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/opt/homebrew/opt/postgresql@18/bin:/opt/homebrew/opt/libpq/bin:/opt/podman/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
export LANG="${LANG:-en_US.UTF-8}"

# The proxy binds the unprivileged 8443 that the pf rule forwards 443 to. Only
# the supervisor gets this: pitchfork builds the URLs it prints from the port,
# and 8443 itself isn't reachable directly while the forward is active. Syncing
# /etc/hosts would need root, and macOS resolves *.localhost on its own.
export PITCHFORK_PROXY_PORT=8443
export PITCHFORK_PROXY_SYNC_HOSTS=false

cd "$HOME"
exec mise x -- pitchfork supervisor run --boot
