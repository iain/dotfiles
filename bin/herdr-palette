#!/usr/bin/env bash
# Command palette for herdr, searched like Raycast: one fzf list holds the
# other agents, workspaces and not yet opened worktrees alongside the actions,
# so typing finds any of them straight away. When nothing matches, Enter
# creates a worktree named after what was typed. Runs as a herdr popup
# (config/herdr/config.toml), which passes the pane underneath as
# HERDR_ACTIVE_PANE_ID, its tab and its working directory.
# Escape closes the palette without doing anything.
set -euo pipefail

cwd=${HERDR_ACTIVE_PANE_CWD:-$PWD}

pick() {
	local prompt=$1
	shift
	fzf --reverse --ansi --prompt "$prompt> " --delimiter $'\t' --with-nth 3.. --tiebreak index "$@"
}

# Typed text becomes a branch name with its spaces turned into dashes.
branch_name() {
	printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/-/g'
}
export -f branch_name

# The popup closes as soon as the script ends, so wait for a key first, or the
# message is gone before it can be read.
fail() {
	echo "$1" >&2
	read -rsn1 -p "press any key to close"
	exit 1
}

# Every source below emits rows of five tab-separated fields: handler,
# argument, kind, text, detail. This turns them into the fzf line, keeping the
# first two hidden for the dispatch at the end.
format_rows() {
	awk -F'\t' '{ printf "%s\t%s\t\033[2m%-9s\033[0m %s  \033[2m%s\033[0m\n", $1, $2, $3, $4, $5 }'
}

# Agents that want attention come first: waiting for input, then done, each
# with the most recent change on top.
agent_rows() {
	local workspace_labels
	workspace_labels=$(herdr workspace list | jq '.result.workspaces | map({(.workspace_id): .label}) | add')
	herdr agent list |
		jq -r --argjson labels "$workspace_labels" --arg active "${HERDR_ACTIVE_PANE_ID:-}" '
			{blocked: "×", working: "◐", done: "✓", idle: "○"} as $symbols
			| {blocked: 0, done: 1, idle: 2, working: 3} as $urgency
			| .result.agents
			| sort_by($urgency[.agent_status] // 4, -.state_change_seq)[]
			| select(.pane_id != $active)
			| ["agent", .pane_id, "agent",
				"\($symbols[.agent_status] // "·") \(.terminal_title_stripped // .agent)",
				$labels[.workspace_id]]
			| join("\t")'
}

action_rows() {
	printf '%s\t\taction\t%s\t\n' \
		open_pr "open this branch's pull request" \
		pitchfork "pitchfork dashboard" \
		new_worktree "new worktree" \
		move_pane_to_workspace "move this pane to another workspace" \
		new_tab "new tab here" \
		rename_tab "rename this tab" \
		scratch_shell "scratch shell" \
		reload_config "reload herdr config"
}

workspace_rows() {
	herdr workspace list |
		jq -r '.result.workspaces[] | select(.focused | not) | ["workspace", .workspace_id, "workspace", .label, ""] | join("\t")'
}

# Worktrees that already have a workspace show up as that workspace. Outside a
# git repo there are none to list.
worktree_rows() {
	local worktrees
	if worktrees=$(herdr worktree list --cwd "$cwd" 2>/dev/null); then
		jq -r --arg home "$HOME" '
			.result.worktrees[]
			| select(.open_workspace_id == null and (.is_bare | not))
			| ["worktree", .path, "worktree", .branch // "detached", (.path | sub("^" + $home; "~"))]
			| join("\t")' <<<"$worktrees"
	fi
}

# Goes through Claude's WorktreeCreate hook, so a worktree made here matches
# one Claude makes: same place, fresh origin/main, no upstream until pushed.
# Asks for the branch unless the palette passes along what was typed.
new_worktree() {
	local branch=${1:-} path
	if [ -z "$branch" ]; then
		read -rp "branch: " branch
	fi
	branch=$(branch_name "$branch")

	if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
		fail "\"$branch\" is not a valid branch name"
	fi
	if ! path=$(jq -n --arg name "$branch" --arg cwd "$cwd" '{name: $name, cwd: $cwd}' |
		bash "$HOME/.claude/hooks/worktree-create.sh"); then
		fail "could not create a worktree for $branch"
	fi
	herdr worktree open --cwd "$cwd" --path "$path" --focus >/dev/null
}

in_git_repo() {
	git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1
}

move_pane_to_workspace() {
	local workspace
	workspace=$(workspace_rows | format_rows | pick workspace | cut -f2)
	herdr pane move "$HERDR_ACTIVE_PANE_ID" --new-tab --workspace "$workspace" --focus >/dev/null
}

rename_tab() {
	local label
	read -rp "tab name: " label
	herdr tab rename "$HERDR_ACTIVE_TAB_ID" "$label" >/dev/null
}

# --print-query makes the first line the query; the second is the picked row,
# missing when nothing matched.
palette_options=(--print-query --bind enter:accept-or-print-query)
if in_git_repo; then
	# While nothing matches, the footer tells what Enter will do. fzf runs the
	# footer command with $SHELL, which is fish here, so ask for bash.
	palette_options+=(--with-shell "bash -c" --bind 'result:transform-footer:if [ "$FZF_MATCH_COUNT" = 0 ]; then printf "↵  new worktree %s" "$(branch_name {q})"; fi')
fi
choice=$({ agent_rows; action_rows; workspace_rows; worktree_rows; } | format_rows | pick herdr "${palette_options[@]}")
query=$(sed -n 1p <<<"$choice")
row=$(sed -n 2p <<<"$choice")
handler=$(cut -f1 <<<"$row")
argument=$(cut -f2 <<<"$row")

if [ -n "$row" ]; then
	case "$handler" in
		agent) herdr agent focus "$argument" >/dev/null ;;
		workspace) herdr workspace focus "$argument" >/dev/null ;;
		worktree) herdr worktree open --cwd "$cwd" --path "$argument" --focus >/dev/null ;;
		open_pr) cd "$cwd" && gh pr view --web ;;
		pitchfork) exec pitchfork tui ;;
		new_tab) herdr tab create --cwd "$cwd" --focus >/dev/null ;;
		scratch_shell) cd "$cwd" && exec "${SHELL:-sh}" ;;
		reload_config) herdr server reload-config >/dev/null ;;
		*) "$handler" ;;
	esac
elif in_git_repo; then
	new_worktree "$query"
fi
