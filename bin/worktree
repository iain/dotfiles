#!/usr/bin/env bash
# Usage: worktree new [--focus] <branch>
#        worktree pr [--focus] <number>
#        worktree rm <path>
#
# The one place worktrees are made, so herdr, Claude and the shell share one
# layout, ~/Code/worktrees/<repo>/<branch-slug> (the [worktrees] directory in
# config/herdr/config.toml). Prints the path as the last line of stdout;
# everything else goes to stderr.
set -euo pipefail

usage() {
	sed -n 's/^# Usage: /usage: /p; s/^#        /       /p' "$0" | head -3 >&2
	exit 2
}

repo_root() {
	dirname "$(git rev-parse --path-format=absolute --git-common-dir)"
}

# herdr's branch_to_path_slug: lowercase, every other run of characters one "-".
path_for() {
	local slug
	slug=$(printf '%s' "$2" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
	echo "$HOME/Code/worktrees/$(basename "$1")/$slug"
}

checkout_of() {
	git -C "$1" worktree list --porcelain | awk -v ref="refs/heads/$2" '
		/^worktree / { path = substr($0, 10) }
		$0 == "branch " ref { print path; exit }
	'
}

new() {
	local branch=${1:-} root path base=HEAD default
	if [ -z "$branch" ]; then
		usage
	fi
	root=$(repo_root)

	path=$(checkout_of "$root" "$branch")
	if [ -z "$path" ]; then
		path=$(path_for "$root" "$branch")
		mkdir -p "$(dirname "$path")"
		if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
			git -C "$root" worktree add --quiet "$path" "$branch" >&2
		else
			# Branch from the default branch as it is on origin now, not as it
			# was at the last fetch.
			if default=$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD); then
				git -C "$root" fetch --quiet origin "${default#origin/}" >&2
				base=$default
			fi
			git -C "$root" worktree add --quiet --no-track -b "$branch" "$path" "$base" >&2
		fi
	fi

	open_in_herdr "$root" "$path"
	echo "$path"
}

pr() {
	local number=${1:-} root branch path
	if [ -z "$number" ]; then
		usage
	fi
	root=$(repo_root)
	branch=pr-$number

	path=$(checkout_of "$root" "$branch")
	if [ -z "$path" ]; then
		path=$(path_for "$root" "$branch")
		add_pr_checkout "$root" "$number" "$branch" "$path"
	fi
	open_in_herdr "$root" "$path"
	echo "$path"
}

add_pr_checkout() {
	local root=$1 number=$2 branch=$3 path=$4
	git -C "$root" fetch --quiet origin "pull/$number/head" >&2
	mkdir -p "$(dirname "$path")"
	git -C "$root" worktree add --quiet -b "$branch" "$path" FETCH_HEAD >&2

	# The same upstream `gh pr checkout` gives a fork's pull request, which is
	# how `gh pr view` finds it. Pushes go to a remote that doesn't exist, as
	# push.default=current would otherwise publish the branch on origin.
	git -C "$root" config "branch.$branch.remote" origin
	git -C "$root" config "branch.$branch.merge" "refs/pull/$number/head"
	git -C "$root" config "branch.$branch.pushRemote" no-pushing-a-review
}

# Never forces: a checkout with uncommitted or untracked files stays on disk
# and the removal fails, so nothing is lost silently. Inside herdr, a
# worktree's workspace closes with it.
remove() {
	local path=${1:-} root branch workspace=""
	if [ -z "$path" ]; then
		usage
	fi
	root=$(dirname "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)")
	branch=$(git -C "$path" branch --show-current)

	if [ "${HERDR_ENV:-}" = "1" ]; then
		workspace=$(herdr worktree list --cwd "$root" |
			jq -r --arg path "$path" '.result.worktrees[]? | select(.path == $path) | .open_workspace_id // empty')
	fi
	if [ -n "$workspace" ]; then
		herdr worktree remove --workspace "$workspace" >/dev/null
	else
		git -C "$root" worktree remove "$path" >&2
	fi

	if [ -n "$branch" ] && ! has_own_commits "$root" "$branch"; then
		git -C "$root" branch --quiet -D "$branch" >&2
	fi
}

# Commits on the branch that aren't on what it started from: the pull request
# for a review branch, the default branch for any other.
has_own_commits() {
	local root=$1 branch=$2 base merge
	merge=$(git -C "$root" config --get "branch.$branch.merge" || true)
	if [[ "$merge" == refs/pull/*/head ]]; then
		git -C "$root" fetch --quiet origin "$merge" >&2
		base=FETCH_HEAD
	elif ! base=$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD); then
		return 0
	fi
	[ "$(git -C "$root" rev-list --count "$base..$branch")" != 0 ]
}

# Gives the worktree a herdr workspace, grouped under its repo, or finds the
# one it already has.
open_in_herdr() {
	if [ "${HERDR_ENV:-}" = "1" ]; then
		herdr worktree open --cwd "$1" --path "$2" "$focus" >/dev/null
	fi
}

command=${1:-}
shift || true
focus=--no-focus
if [ "${1:-}" = "--focus" ]; then
	focus=--focus
	shift
fi
case "$command" in
	new) new "$@" ;;
	pr) pr "$@" ;;
	rm) remove "$@" ;;
	*) usage ;;
esac
