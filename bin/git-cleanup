#!/usr/bin/env bash
#
# git-cleanup — delete local branches whose work has landed, and the
# worktrees attached to them.
#
# A branch is removable when either:
#   - its pull request was merged and the branch still points at the commit
#     that was merged, which is how squash merges are recognised, or
#   - it was pushed and is merged into the repository default branch.
#
# A branch marked [gone] that is neither is listed but kept: its PR was
# closed unmerged, or its remote branch was deleted by hand.
#
# A worktree on a detached HEAD is removable when that HEAD is the commit a
# merged pull request ended on.
#
# A worktree open in herdr is removed through herdr, which also closes its
# workspace. Worktrees with uncommitted changes, or with a herdr agent still
# working or waiting for input in them, are skipped; the current branch and
# the default branch are never deleted.

set -euo pipefail

PROG=$(basename "$0")

usage() {
  cat <<EOF
Usage: $PROG [-n|--dry-run] [-h|--help]

Delete local branches whose pull request was merged, or that are merged into
the default branch, removing any attached worktrees and herdr workspaces
first. Worktrees with uncommitted changes or a busy herdr agent are skipped.

Options:
  -n, --dry-run   Show what would happen. Still fetches from the remotes,
                  so the result matches a real run, but removes nothing.
  -h, --help      Show this help.
EOF
}

dry_run=0
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf '%s: unknown option: %s\n\n' "$PROG" "$1" >&2; usage >&2; exit 2 ;;
  esac
done

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "$PROG: not inside a git repository" >&2
  exit 1
fi

# Dry-run lines go to stderr, so they still show when a command's own output
# is silenced.
run() {
  if [ "$dry_run" = 1 ]; then
    {
      printf '  [dry-run]'
      printf ' %q' "$@"
      printf '\n'
    } >&2
  else
    "$@"
  fi
}

echo "Fetching from all remotes..."
if ! git fetch --all --prune; then
  echo "$PROG: warning: git fetch failed, continuing with existing state" >&2
fi

echo "Pruning stale worktree metadata..."
run git worktree prune

repo_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

# Default branch from origin/HEAD; fall back to main.
default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
if [ -z "${default_branch:-}" ]; then
  default_branch=main
fi

# Empty in detached HEAD — that's fine.
current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

# Merged pull requests as "branch<TAB>head commit".
merged_prs=""
if command -v gh >/dev/null 2>&1; then
  if ! merged_prs=$(gh pr list --state merged --author @me --limit 500 \
      --json headRefName,headRefOid --jq '.[] | "\(.headRefName)\t\(.headRefOid)"' 2>/dev/null); then
    echo "$PROG: warning: could not list merged pull requests, only checking git" >&2
    merged_prs=""
  fi
else
  echo "$PROG: warning: gh is not installed, squash-merged branches won't be found" >&2
fi

# Branches already merged into the default branch (skip if the local default
# branch is missing — merged pull requests are still found).
merged_branches=""
if git show-ref --verify --quiet "refs/heads/$default_branch"; then
  merged_branches=$(git branch --merged "$default_branch" --format='%(refname:short)')
else
  echo "$PROG: warning: local $default_branch not found, skipping --merged check" >&2
fi

# herdr's view of the worktrees: "path<TAB>workspace" for those open in a
# workspace, and "workspace<TAB>cwd" for agents that are working or waiting
# for input. Both stay empty when herdr isn't running.
herdr_workspaces=""
busy_agents=""
if command -v herdr >/dev/null 2>&1; then
  herdr_workspaces=$(herdr worktree list --cwd "$repo_root" 2>/dev/null |
    jq -r '.result.worktrees[] | select(.open_workspace_id) | "\(.path)\t\(.open_workspace_id)"' 2>/dev/null || true)
  busy_agents=$(herdr agent list 2>/dev/null |
    jq -r '.result.agents[] | select(.agent_status == "working" or .agent_status == "blocked") | "\(.workspace_id)\t\(.cwd)"' 2>/dev/null || true)
fi

# Map branch -> worktree path.
worktrees=$(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10); next }
  /^branch refs\/heads\// {
    branch = substr($0, 19)
    printf "%s\t%s\n", branch, path
  }
')

# Worktrees on a detached HEAD, as "path<TAB>commit".
detached_worktrees=$(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10); next }
  /^HEAD /     { head = substr($0, 6); next }
  /^detached$/ { printf "%s\t%s\n", path, head }
')

worktree_for() {
  printf '%s\n' "$worktrees" | awk -F '\t' -v b="$1" '$1 == b { print $2; exit }'
}

workspace_for() {
  printf '%s\n' "$herdr_workspaces" | awk -F '\t' -v p="$1" '$1 == p { print $2; exit }'
}

# True when an agent that is working or waiting for input runs in the given
# workspace, or anywhere inside the given worktree.
agent_busy_in() {
  printf '%s\n' "$busy_agents" | awk -F '\t' -v w="$1" -v p="$2" '
    ($1 != "" && $1 == w) || $2 == p || index($2, p "/") == 1 { found = 1 }
    END { exit !found }
  '
}

pr_merged_at() {
  printf '%s\n' "$merged_prs" | awk -F '\t' -v b="$1" -v c="$2" '
    $1 == b && $2 == c { found = 1 }
    END { exit !found }
  '
}

is_merged_pr_head() {
  printf '%s\n' "$merged_prs" | awk -F '\t' -v c="$1" '
    $2 == c { found = 1 }
    END { exit !found }
  '
}

has_merged_pr() {
  printf '%s\n' "$merged_prs" | awk -F '\t' -v b="$1" '
    $1 == b { found = 1 }
    END { exit !found }
  '
}

is_merged_into_default() {
  printf '%s\n' "$merged_branches" | grep -qxF "$1"
}

# Removes the branch's worktree, if it has one. Fails when it has to stay.
remove_worktree() {
  local branch=$1 wt=$2 workspace status_out

  if [ "$wt" = "$repo_root" ]; then
    echo "$branch: checked out in the main checkout, skipping"
    return 1
  fi

  if ! status_out=$(git -C "$wt" status --porcelain); then
    echo "$branch: failed to read worktree at $wt, skipping" >&2
    return 1
  fi
  if [ -n "$status_out" ]; then
    echo "$branch: worktree $wt has uncommitted changes, skipping"
    return 1
  fi

  workspace=$(workspace_for "$wt")
  if agent_busy_in "$workspace" "$wt"; then
    echo "$branch: an agent is still working in $wt, skipping"
    return 1
  fi

  if [ -n "$workspace" ]; then
    echo "$branch: closing herdr workspace $workspace and removing worktree $wt"
    if ! run herdr worktree remove --workspace "$workspace" >/dev/null; then
      echo "$branch: failed to remove worktree, skipping" >&2
      return 1
    fi
  else
    echo "$branch: removing worktree $wt"
    if ! run git worktree remove "$wt"; then
      echo "$branch: failed to remove worktree, skipping" >&2
      return 1
    fi
  fi
}

deleted=0
removed_worktrees=0
skipped=0

while IFS=$'\t' read -r branch upstream track; do
  if [ "$branch" = "$default_branch" ]; then
    continue
  fi

  tip=$(git rev-parse "refs/heads/$branch")
  if pr_merged_at "$branch" "$tip"; then
    :
  elif [ -n "$upstream" ] && is_merged_into_default "$branch"; then
    :
  elif has_merged_pr "$branch"; then
    echo "$branch: has commits after its pull request was merged, keeping"
    skipped=$((skipped + 1))
    continue
  elif [ "$track" = "[gone]" ]; then
    echo "$branch: upstream is gone but it isn't merged, keeping"
    skipped=$((skipped + 1))
    continue
  else
    continue
  fi

  if [ -n "$current_branch" ] && [ "$branch" = "$current_branch" ]; then
    echo "$branch: currently checked out, skipping"
    skipped=$((skipped + 1))
    continue
  fi

  wt=$(worktree_for "$branch")
  if [ -n "$wt" ]; then
    if remove_worktree "$branch" "$wt"; then
      removed_worktrees=$((removed_worktrees + 1))
    else
      skipped=$((skipped + 1))
      continue
    fi
  fi

  echo "$branch: deleting branch"
  if run git branch -D "$branch"; then
    deleted=$((deleted + 1))
  else
    echo "$branch: failed to delete branch" >&2
    skipped=$((skipped + 1))
  fi
done < <(git for-each-ref --format='%(refname:short)%09%(upstream)%09%(upstream:track)' refs/heads)

current_worktree=$(git rev-parse --show-toplevel)

while IFS=$'\t' read -r wt head; do
  if [ -z "$wt" ]; then
    continue
  fi
  if ! is_merged_pr_head "$head"; then
    continue
  fi

  label="detached ${head:0:9}"
  if [ "$wt" = "$current_worktree" ]; then
    echo "$label: currently checked out, skipping"
    skipped=$((skipped + 1))
  elif remove_worktree "$label" "$wt"; then
    removed_worktrees=$((removed_worktrees + 1))
  else
    skipped=$((skipped + 1))
  fi
done <<< "$detached_worktrees"

if [ "$dry_run" = 1 ]; then
  printf '\n%d branches would be deleted, %d worktrees removed, %d kept or skipped\n' \
    "$deleted" "$removed_worktrees" "$skipped"
else
  printf '\n%d branches deleted, %d worktrees removed, %d kept or skipped\n' \
    "$deleted" "$removed_worktrees" "$skipped"
fi
