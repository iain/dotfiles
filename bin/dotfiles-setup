#!/usr/bin/env ruby
# frozen_string_literal: true

# Per-machine setup that mise bootstrap's declarative sections can't express:
# interactive git identity, ssh config seeding, fish local config, this machine's
# signing key in allowed_signers, the read-only
# commit-signing diagnostic, and Claude plugins + rubocop MCP + herdr hooks. Driven by mise
# tasks (see mise.toml at the repo root); each subcommand is idempotent and safe
# to re-run.
#
# Usage: dotfiles-setup <identity|claude|signing|all>
#        dotfiles-setup upgrade [--dry-run]
#
# The repo is located via this script's own realpath, so it works wherever the
# dotfiles are cloned — no hardcoded path.

require "fileutils"
require "json"
require "pathname"

REPO        = Pathname.new(File.realpath(__FILE__)).dirname.parent
CONFIG_SRC  = REPO / "config"
CLAUDE_SRC  = REPO / "claude"
HOME        = Pathname.new(Dir.home)
CONFIG_DEST = HOME / ".config"
CLAUDE_DEST = HOME / ".claude"

# Each Claude profile's directory, with the CLAUDE_CONFIG_DIR that selects it.
# The default profile runs with the variable unset: when it's set, even to
# ~/.claude, Claude keeps .claude.json inside that dir instead of in $HOME.
CLAUDE_PROFILES = {
  CLAUDE_DEST              => nil,
  HOME / ".claude-private" => (HOME / ".claude-private").to_s
}.freeze

def ask(question, default = nil)
  suffix = default ? " [#{default}]" : ""
  print "  #{question}#{suffix}: "
  answer = $stdin.gets&.strip
  answer.nil? || answer.empty? ? default : answer
end

# Seed ~/.config/git/config.local (per-machine identity), ~/.ssh/config, and
# fish's local config. Skips anything already present; prompts only on a TTY.
def setup_identity
  git_local = CONFIG_DEST / "git" / "config.local"
  if git_local.exist?
    puts "  skip #{git_local} (already exists)"
  elsif $stdin.tty?
    puts "Setting up git identity (#{git_local})..."
    name = ask("Git name", github_user_field("name"))
    email = ask("Git email", github_user_field("email"))
    key = ask("SSH signing key path", "~/.ssh/id_ed25519.pub")
    FileUtils.mkdir_p(git_local.dirname)
    git_local.write(<<~CONFIG)
      [user]
        email = #{email}
        name = #{name}
        signingKey = #{key}
    CONFIG
    puts "  created #{git_local}"
  else
    warn "  WARNING: #{git_local} missing and no TTY; run `mise run setup-identity` interactively."
  end

  ssh_config = HOME / ".ssh" / "config"
  if ssh_config.exist?
    puts "  skip #{ssh_config} (already exists)"
  else
    FileUtils.mkdir_p(ssh_config.dirname, mode: 0o700)
    ssh_config.write(<<~CONFIG)
      Host *
        AddKeysToAgent yes
        UseKeychain yes
        IdentityFile ~/.ssh/id_ed25519
    CONFIG
    FileUtils.chmod(0o600, ssh_config)
    puts "  created #{ssh_config}"
  end

  fish_local = CONFIG_DEST / "fish" / "config.local.fish"
  if fish_local.exist?
    puts "  skip #{fish_local} (already exists)"
  else
    FileUtils.mkdir_p(fish_local.dirname)
    fish_local.write(<<~CONFIG)
      # Local fish config — secrets and machine-specific settings
      # This file is not checked into git.
    CONFIG
    puts "  created #{fish_local}"
  end

  allow_signing_key
end

# A field of the GitHub account gh is logged in to, or nil: gh may be missing
# or logged out, and a private email reads as empty.
def github_user_field(field)
  value = ""
  if system("command -v gh > /dev/null 2>&1")
    value = `gh api user --jq .#{field} 2>/dev/null`.strip
  end

  if value.empty?
    nil
  else
    value
  end
end

# Add this machine's signing key to the tracked allowed_signers, so its commits
# verify locally. The change is left for you to commit.
def allow_signing_key
  signing_key = `git config --get user.signingkey`.strip
  email       = `git config --get user.email`.strip
  key_path    = Pathname.new(signing_key.sub(/\A~/, Dir.home))
  allowed     = CONFIG_SRC / "git" / "allowed_signers"

  if signing_key.empty? || email.empty? || !key_path.file?
    puts "  skip #{allowed} (no signing key or email yet)"
  else
    pubkey = key_path.read.split[0, 2].join(" ")
    if allowed.read.include?(pubkey)
      puts "  skip #{allowed} (signing key already allowed)"
    else
      machine = `scutil --get LocalHostName`.strip
      allowed.write("# #{machine}\n#{email} #{pubkey}\n", mode: "a")
      puts "  added this machine's signing key to #{allowed}; commit it"
    end
  end
end

# Reproduce the Claude plugin + MCP setup declared in claude/settings.json.
# Marketplaces and enabled plugins are read from the committed settings (the
# single source of truth); the rubocop MCP server is registered at user scope.
# Each action is guarded by a presence check, so re-runs are no-ops.
def setup_claude
  unless system("command -v claude > /dev/null 2>&1")
    puts "  skip Claude setup (claude not installed)"
    return
  end

  settings = JSON.parse((CLAUDE_SRC / "settings.json").read)
  CLAUDE_PROFILES.each do |dir, config_dir|
    puts "Installing Claude plugins and MCP servers in #{dir}..."
    env = { "CLAUDE_CONFIG_DIR" => config_dir }
    install_claude_plugins(env, settings)
    register_rubocop_mcp(env)
  end

  # Registers herdr's hooks in the tracked settings.json (through the symlink)
  # and writes the untracked hook script they call, so a machine that gets the
  # committed hooks also gets the script. Always run, so a herdr upgrade that
  # ships a new hook version reaches it; settings.json is only rewritten when
  # its hooks differ. Run once, for the default profile: the other profiles
  # share its settings.json, and the hooks call the script in ~/.claude.
  if system("command -v herdr > /dev/null 2>&1")
    system({ "CLAUDE_CONFIG_DIR" => nil }, "herdr", "integration", "install", "claude") ||
      warn("  WARNING: could not install the herdr Claude integration")
    install_herdr_skill
  else
    puts "  skip herdr integration (herdr not installed)"
  end
end

def install_claude_plugins(env, settings)
  known = IO.popen(env, %w[claude plugin marketplace list], err: File::NULL, &:read)
  settings.fetch("extraKnownMarketplaces", {}).each do |name, spec|
    repo = spec.dig("source", "repo")
    next unless repo

    if known.include?(name)
      puts "  skip marketplace #{name} (already known)"
    else
      system(env, "claude", "plugin", "marketplace", "add", repo) || warn("  WARNING: could not add marketplace #{repo}")
    end
  end

  installed = IO.popen(env, %w[claude plugin list], err: File::NULL, &:read)
  settings.fetch("enabledPlugins", {}).each do |ref, enabled|
    next unless enabled

    if installed.include?(ref)
      puts "  skip plugin #{ref} (already installed)"
    else
      system(env, "claude", "plugin", "install", ref) || warn("  WARNING: could not install plugin #{ref}")
    end
  end
end

def register_rubocop_mcp(env)
  rubocop_mcp = CLAUDE_DEST / "bin" / "rubocop-mcp"
  if system(env, "claude mcp get rubocop > /dev/null 2>&1")
    puts "  skip mcp rubocop (already registered)"
  else
    system(env, "claude", "mcp", "add", "--scope", "user", "rubocop", "--", rubocop_mcp.to_s) ||
      warn("  WARNING: could not register rubocop MCP server")
  end
end

# herdr prints a Claude skill for its own CLI. It's written untracked, straight
# into each profile, so it always matches the installed herdr.
def install_herdr_skill
  skill = `herdr --skill`
  unless $?.success?
    warn "  WARNING: could not print the herdr skill"
    return
  end

  CLAUDE_PROFILES.each_key do |dir|
    skill_file = dir / "skills" / "herdr" / "SKILL.md"
    if skill_file.file? && skill_file.read == skill
      puts "  skip herdr skill in #{dir} (up to date)"
    else
      FileUtils.mkdir_p(skill_file.dirname)
      skill_file.write(skill)
      puts "  wrote #{skill_file}"
    end
  end
end

# Read-only check of the commit-signing chain. A new machine typically signs
# with a key that is trusted nowhere — not in allowed_signers, not on GitHub —
# so commits come out "Unverified" and nobody notices for weeks. This surfaces
# each gap and prints the exact fix without changing anything.
def check_signing
  puts "Checking git commit signing..."
  problems = []

  config_local = CONFIG_DEST / "git" / "config.local"
  unless config_local.file?
    problems << "Per-machine identity missing (#{config_local}); commits use an auto-detected name/email.\n" \
                "    Fix: run `mise run setup-identity`."
  end

  signing_key = `git config --get user.signingkey`.strip
  if signing_key.empty?
    problems << "user.signingkey is not set."
  else
    key_path = Pathname.new(signing_key.sub(/\A~/, Dir.home))
    if key_path.file?
      pubkey = key_path.read.split[0, 2].join(" ")
      email  = `git config --get user.email`.strip

      allowed = CONFIG_SRC / "git" / "allowed_signers"
      unless allowed.file? && allowed.read.include?(pubkey)
        problems << "Signing key not in #{allowed}; your commits verify as untrusted locally.\n" \
                    "    Fix: add this line to config/git/allowed_signers:\n" \
                    "      #{email} #{pubkey}"
      end

      if system("command -v gh > /dev/null 2>&1") && system("gh auth status > /dev/null 2>&1")
        login      = `gh api user --jq .login 2>/dev/null`.strip
        registered = `gh api users/#{login}/ssh_signing_keys --jq '.[].key' 2>/dev/null`
        unless registered.include?(pubkey)
          problems << "Signing key not registered on GitHub; pushed commits show \"Unverified\".\n" \
                      "    Fix: gh ssh-key add #{key_path} --type signing --title \"<machine-name>\"\n" \
                      "    (first run if needed: gh auth refresh -h github.com -s admin:ssh_signing_key)"
        end
      end
    else
      problems << "Signing key #{key_path} does not exist on this machine."
    end
  end

  if problems.empty?
    puts "  signing OK"
  else
    problems.each { |p| warn "  WARNING: #{p}" }
  end
end

# Updates that `mise bootstrap packages upgrade` and `mise upgrade` don't reach.
# Run by `mise run upgrade`, after those. With --dry-run, only what reads runs.
def upgrade(dry_run:)
  upgrade_claude_plugins(dry_run)
  upgrade_vim_plugins(dry_run)
  relink_formulae(dry_run)
  list_macos_updates
end

# Runs a command that changes something, or in a dry run only says so.
def change(dry_run, *command, failure:, env: {})
  if dry_run
    puts "  would run: #{command.join(" ")}"
  else
    system(env, *command) || warn("  WARNING: #{failure}")
  end
end

# Listed only: installing one can need a restart, so that stays a choice.
def list_macos_updates
  puts "Checking for macOS updates..."
  system("softwareupdate", "--list") || warn("  WARNING: could not check for macOS updates")
end

# A `brew upgrade` whose link step fails leaves the new keg unlinked, and mise
# still counts it as installed: its opt link resolves. That once took gh off
# PATH unnoticed.
def relink_formulae(dry_run)
  installed = IO.popen(%w[brew info --json=v2 --installed], err: File::NULL, &:read)
  if installed.empty?
    warn "  WARNING: could not list the Homebrew formulae to check their links"
  else
    formulae = JSON.parse(installed)["formulae"]
    unlinked = formulae.select { |formula| !formula["keg_only"] && formula["linked_keg"].nil? }
    unlinked.each do |formula|
      puts "Relinking #{formula["name"]}..."
      change(dry_run, "brew", "link", formula["name"],
             failure: "could not link #{formula["name"]}; see `brew link #{formula["name"]}`")
    end
  end
end

# Silent Ex mode, so it runs without a terminal UI. That mode skips the vimrc,
# and with it vim-plug, unless -u names it. --sync makes PlugUpdate finish
# before :qa quits.
def upgrade_vim_plugins(dry_run)
  puts "Updating vim plugins..."
  change(dry_run, "vim", "-N", "-u", (HOME / ".vimrc").to_s, "-es", "+PlugUpgrade", "+PlugUpdate --sync", "+qa",
         failure: "could not update the vim plugins")
end

# Claude only loads updated plugins after a restart.
def upgrade_claude_plugins(dry_run)
  settings = JSON.parse((CLAUDE_SRC / "settings.json").read)
  CLAUDE_PROFILES.each do |dir, config_dir|
    puts "Updating Claude plugins in #{dir}..."
    env = { "CLAUDE_CONFIG_DIR" => config_dir }
    change(dry_run, "claude", "plugin", "marketplace", "update", env: env, failure: "could not update the marketplaces")
    settings.fetch("enabledPlugins", {}).each do |ref, enabled|
      if enabled
        change(dry_run, "claude", "plugin", "update", ref, env: env, failure: "could not update plugin #{ref}")
      end
    end
  end
end

case ARGV[0]
when "identity"  then setup_identity
when "upgrade"   then upgrade(dry_run: ARGV.include?("--dry-run"))
when "claude"    then setup_claude
when "signing"   then check_signing
when "all", nil
  setup_identity
  setup_claude
  check_signing
else
  warn "Usage: dotfiles-setup <identity|claude|signing|all|upgrade [--dry-run]>"
  exit 1
end
