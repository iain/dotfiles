#!/usr/bin/env bash
#
# rubocop MCP launcher — one user-scoped MCP server that adapts to whatever
# repo Claude Code is started in. Registered via:
#   claude mcp add --scope user --transport stdio rubocop -- ~/.claude/bin/rubocop-mcp
#
# Why this exists:
#   * --no-server is mandatory: rubocop's caching daemon proxies the call and
#     detaches, which silently kills the long-lived MCP stdio pipe.
#   * Repos put the Ruby app in different places (repo root, ./backend,
#     ./apps/<x>), so we locate the project rather than assume cwd.
#   * Repos pin different Ruby versions via mise; `mise exec` re-activates the
#     right toolchain per repo (the MCP process inherits a frozen PATH).
#
# rubocop --mcp only runs where the `mcp` gem is bundled; a repo can hold
# several Ruby projects with only one wired up for it, so we target that one
# (see resolution below). A repo can still override with a local-scope
# `rubocop` MCP server (local > user precedence).

set -o pipefail

start="${CLAUDE_PROJECT_DIR:-$PWD}"

# Find $1 by name beneath $start, skipping noise dirs.
find_down() {
  find "$start" -maxdepth 5 \
    \( -name node_modules -o -name vendor -o -name tmp -o -name .git -o -name .bundle \) -prune \
    -o -name "$1" -print 2>/dev/null
}

# Sort find(1) output shallowest-first, ties broken alphabetically — keeps
# selection deterministic regardless of filesystem order.
sort_by_depth() {
  awk '{ n = gsub(/\//, "/"); print n "\t" $0 }' | sort -k1,1n -k2,2 | cut -f2-
}
pick_shallowest() { sort_by_depth | head -1; }

# rubocop --mcp needs the `mcp` gem in that project's bundle.
has_mcp_gem() {
  [ -f "$1/Gemfile.lock" ] && grep -Eq '^[[:space:]]+mcp \(' "$1/Gemfile.lock"
}

root=""

# 1) The project that can actually serve MCP wins: the one whose bundle has the
#    `mcp` gem. Look up through ancestors first (mcp gem at an app root above
#    us, e.g. Claude launched in a subdir), then the shallowest match below us.
d="$start"
while [ -n "$d" ] && [ "$d" != "/" ]; do
  if has_mcp_gem "$d"; then root="$d"; break; fi
  d="$(dirname "$d")"
done
if [ -z "$root" ]; then
  while IFS= read -r lock; do
    [ -n "$lock" ] || continue
    if has_mcp_gem "$(dirname "$lock")"; then root="$(dirname "$lock")"; break; fi
  done <<< "$(find_down Gemfile.lock | sort_by_depth)"
fi

# 2) No MCP-capable bundle found. Fall back to a best-effort rubocop project:
#    nearest ancestor with a Gemfile (app at repo root, or launched inside it).
if [ -z "$root" ]; then
  d="$start"
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    if [ -f "$d/Gemfile" ]; then root="$d"; break; fi
    d="$(dirname "$d")"
  done
fi

# 3) Otherwise search downward: prefer a dir holding a .rubocop.yml (that's
#    unambiguously a rubocop project); fall back to the shallowest Gemfile.
if [ -z "$root" ]; then
  rc="$(find_down .rubocop.yml | pick_shallowest)"
  if [ -n "$rc" ]; then
    root="$(dirname "$rc")"
  else
    gf="$(find_down Gemfile | pick_shallowest)"
    [ -n "$gf" ] && root="$(dirname "$gf")"
  fi
fi

[ -z "$root" ] && root="$start"
cd "$root" || exit 1

# Activate this repo's toolchain when mise manages it (Ruby version may differ
# per repo, and mise merges config up the tree so a subdir inherits the root).
runner=()
if command -v mise >/dev/null 2>&1 \
   && { [ -f mise.toml ] || [ -f .mise.toml ] || [ -f .tool-versions ] || [ -f .ruby-version ] \
        || mise config 2>/dev/null | grep -q .; }; then
  runner=(mise exec --)
fi

if [ -f Gemfile ] && "${runner[@]}" bundle show rubocop >/dev/null 2>&1; then
  exec "${runner[@]}" bundle exec rubocop --no-server --mcp
elif "${runner[@]}" rubocop --version >/dev/null 2>&1; then
  exec "${runner[@]}" rubocop --no-server --mcp
fi

echo "rubocop-mcp: no rubocop found for ${root}" >&2
exit 1
